<script>var b=document.getElementById('bg'),n=document.getElementById('nv');b.onclick=function(){var o=n.classList.toggle('open');b.setAttribute('aria-expanded',o)};n.onclick=function(){n.classList.remove('open')}</script>
<script>
var chips=document.querySelectorAll('.chip'),shots=document.querySelectorAll('.shot');
chips.forEach(function(c){c.onclick=function(){chips.forEach(function(x){x.setAttribute('aria-pressed',x==c)});shots.forEach(function(s){s.hidden=!(c.dataset.c=='All'||s.dataset.c==c.dataset.c)})}});
var lb=document.getElementById('lb');
shots.forEach(function(s){s.querySelector('button').onclick=function(){var im=s.querySelector('img');if(!im)return;lb.querySelector('img').src=im.src;lb.querySelector('img').alt=im.alt;lb.querySelector('h3').textContent=s.querySelector('h3').textContent;lb.querySelector('p').textContent=s.querySelector('p').textContent;lb.showModal()}});
lb.querySelector('.x').onclick=function(){lb.close()};lb.onclick=function(e){if(e.target==lb)lb.close()};
</script></body></html>